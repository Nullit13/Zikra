{
    "manifest_version": 3,
    "name": "Zikra",
    "description": "A gentle athkar reminder while you browse.",
    "version": "1.0.0",
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "storage"
    ],
    "icons": {
        "128": "images/icon.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }